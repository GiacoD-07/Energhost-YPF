# Copiar este archivo como ".env" y completar los valores.
# El archivo .env NUNCA se sube al repositorio.

# Entorno: dev muestra los errores en pantalla, prod los oculta
APP_ENV=dev

# Dirección donde se publica el panel (se usa para armar el link del QR de la etiqueta)
PANEL_URL=http://localhost:8000

# --- Firebase Realtime Database ---
# URL de la base (se ve en la consola de Firebase, pestaña "Datos")
FIREBASE_URL=https://tu-proyecto-default-rtdb.firebaseio.com
# Clave secreta de la base (Configuración del proyecto > Cuentas de servicio > Secretos de la base de datos)
FIREBASE_AUTH=

# --- Reglas (deben coincidir con el contrato de datos y el firmware) ---
SEGUNDOS_PARA_DESCONECTADO=30
UMBRAL_SOBRECONSUMO_W=2500

# --- Cálculos ---
# Precio del kWh: sacarlo de una factura reciente (con impuestos incluidos)
PRECIO_KWH_PESOS=50
CARGO_FIJO_PESOS=0
# Factor oficial de emisión del consumo de electricidad de la red (SNIGEI-AR, dato 2022)
CO2_EMISSION_FACTOR_KG_PER_KWH=0.283
